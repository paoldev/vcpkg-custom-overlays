diff --git a/my-uwp-support.patch b/my-uwp-support.patch
new file mode 100644
index 0000000..8ed9438
--- /dev/null
+++ b/my-uwp-support.patch
@@ -0,0 +1,173 @@
+diff --git a/meson.build b/meson.build
+index 600cdf9..0dd3b8f 100644
+--- a/meson.build
++++ b/meson.build
+@@ -501,11 +501,18 @@ if host_machine.system() == 'darwin' and not get_option('quartz').disabled()
+   endif
+ endif
+ 
++is_uwp = false  # used in src/meson.build
+ if host_machine.system() == 'windows'
+   add_languages('cpp', native: false)
+ 
+   add_project_arguments('-DWIN32_LEAN_AND_MEAN', '-DNOMINMAX', language: ['c', 'cpp'])
+ 
++  winapi_family = cc.get_define('WINAPI_FAMILY')
++  is_uwp = ['WINAPI_FAMILY_APP', 'WINAPI_FAMILY_PC_APP', '2'].contains(winapi_family)
++  is_win32 = not is_uwp
++
++  # When compiling cairo for 'uwp', remove 'win32' stuff.
++  if is_win32  
+   win32_extra_deps = [
+     cc.find_library('gdi32'),
+     cc.find_library('msimg32'),
+@@ -528,10 +535,14 @@ if host_machine.system() == 'windows'
+       'deps': win32_extra_deps,
+     }
+   ]
++  endif
+ 
+   cpp_compiler = meson.get_compiler('cpp')
+ 
+-  if get_option('dwrite').allowed()
++  # TODO: dwrite should be supported in uwp mode
++  if is_uwp
++    add_project_arguments('-DWINVER=_WIN32_WINNT_WIN10', '-D_WIN32_WINNT=_WIN32_WINNT_WIN10', '-DNTDDI_VERSION=0x0A000010', language: ['c', 'cpp'])
++  elif get_option('dwrite').allowed()
+     d2d_dep = cpp_compiler.find_library('d2d1')
+     dwrite_dep = cpp_compiler.find_library('dwrite')
+     wincodec_dep = cpp_compiler.find_library('windowscodecs')
+diff --git a/src/cairo-misc.c b/src/cairo-misc.c
+index 59cf76f..5c6ef28 100644
+--- a/src/cairo-misc.c
++++ b/src/cairo-misc.c
+@@ -1025,13 +1025,15 @@ _cairo_win32_tmpfile (void)
+     if (GetTempFileNameW (path_name, L"cairo_", 0, file_name) == 0)
+ 	return NULL;
+ 
+-    handle = CreateFileW (file_name,
++    CREATEFILE2_EXTENDED_PARAMETERS params = {};
++    params.dwSize = sizeof(params);
++    params.dwFileAttributes = FILE_ATTRIBUTE_NORMAL | FILE_ATTRIBUTE_TEMPORARY;
++    params.dwFileFlags = FILE_FLAG_DELETE_ON_CLOSE;
++    handle = CreateFile2 (file_name,
+ 			 GENERIC_READ | GENERIC_WRITE,
+ 			 0,
+-			 NULL,
+ 			 CREATE_ALWAYS,
+-			 FILE_ATTRIBUTE_NORMAL | FILE_FLAG_DELETE_ON_CLOSE,
+-			 NULL);
++			 &params);
+     if (handle == INVALID_HANDLE_VALUE) {
+ 	DeleteFileW (file_name);
+ 	return NULL;
+diff --git a/src/cairo-win32.h b/src/cairo-win32.h
+index db4cac6..ba6df96 100644
+--- a/src/cairo-win32.h
++++ b/src/cairo-win32.h
+@@ -109,7 +109,7 @@ cairo_win32_scaled_font_get_device_to_logical (cairo_scaled_font_t *scaled_font,
+ 
+ CAIRO_END_DECLS
+ 
+-#else  /* CAIRO_HAS_WIN32_SURFACE */
++#elif !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2) /* CAIRO_HAS_WIN32_SURFACE */
+ # error Cairo was not compiled with support for the win32 backend
+ #endif /* CAIRO_HAS_WIN32_SURFACE */
+ 
+diff --git a/src/meson.build b/src/meson.build
+index 7e71299..3bf55c2 100644
+--- a/src/meson.build
++++ b/src/meson.build
+@@ -233,6 +233,12 @@ foreach feature: built_features
+   cairo_headers += cairo_feature_headers.get(source_key, [])
+ endforeach
+ 
++if is_uwp
++  # When compiling cairo for 'uwp', 'cairo-win32-system.c' file
++  # is still required, to correctly initialize Win32 mutexes.
++  cairo_sources += ['win32/cairo-win32-system.c', 'win32/cairo-win32-thread-data.c']
++endif
++
+ incsrc = include_directories('.')
+ 
+ cairo_static_args = []
+diff --git a/src/win32/cairo-win32-system.c b/src/win32/cairo-win32-system.c
+index 8f24150..53624af 100644
+--- a/src/win32/cairo-win32-system.c
++++ b/src/win32/cairo-win32-system.c
+@@ -156,6 +156,7 @@ mta_thread_main (void *user_data)
+ void
+ cairo_win32_ensure_mta (void)
+ {
++#if !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2)
+     if (_cairo_atomic_init_once_enter (&mta.once)) {
+         HMODULE ole32 = _cairo_win32_load_library_from_system32 (L"OLE32.DLL");
+ 
+@@ -199,13 +200,14 @@ cairo_win32_ensure_mta (void)
+ 
+         _cairo_atomic_init_once_leave (&mta.once);
+     }
++#endif
+ }
+ 
+ static void
+ cairo_win32_mta_finalize (void)
+ {
+     /* Loader-lock-safe */
+-
++#if !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2)
+     if (_cairo_atomic_init_once_check (&mta.once)) {
+         if (mta.mta_usage.cookie_is_set) {
+             void *free_func = mta.mta_usage.pCoDecrementMTAUsage;
+@@ -221,21 +223,26 @@ cairo_win32_mta_finalize (void)
+             CloseHandle (mta.thread);
+         }
+     }
++#endif
+ }
+ 
+ void
+ cairo_win32_async_stdcall_free (stdcall_free_func_t func, void *data)
+ {
++#if !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2)
+     QueueUserWorkItem (func, data, WT_EXECUTEDEFAULT);
++#endif
+ }
+ 
+ void
+ cairo_win32_async_com_release (IUnknown *iface_ptr)
+ {
++#if !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2)
+     if (iface_ptr) {
+         QueueUserWorkItem ((void *) iface_ptr->lpVtbl->Release,
+                            iface_ptr, WT_EXECUTEDEFAULT);
+     }
++#endif
+ }
+ 
+ static void
+@@ -248,7 +255,9 @@ cairo_win32_initialize (void)
+ static void
+ cairo_win32_finalize (void)
+ {
++#if CAIRO_HAS_DWRITE_FONT
+     cairo_win32_dwrite_finalize ();
++#endif
+     cairo_win32_thread_data_finalize ();
+     cairo_win32_mta_finalize ();
+     CAIRO_MUTEX_FINALIZE ();
+diff --git a/src/win32/cairo-win32-thread-data.c b/src/win32/cairo-win32-thread-data.c
+index 914144d..399c4d3 100644
+--- a/src/win32/cairo-win32-thread-data.c
++++ b/src/win32/cairo-win32-thread-data.c
+@@ -103,8 +103,10 @@ thread_data_free (cairo_win32_thread_data_t *data)
+          * thread-exit and our asynchronous delete would be racy. For more
+          * informations, refer to the MSDN docs for CreateCompatibleDC.
+          */
++#if !defined(WINAPI_FAMILY) || (WINAPI_FAMILY != 2)
+         void *free_func = DeleteDC;
+         cairo_win32_async_stdcall_free (free_func, data->hdc);
++#endif
+     }
+ 
+ #if CAIRO_HAS_DWRITE_FONT
diff --git a/portfile.cmake b/portfile.cmake
index 305feff..ce5a2f6 100644
--- a/portfile.cmake
+++ b/portfile.cmake
@@ -14,6 +14,7 @@ vcpkg_extract_source_archive(
     ARCHIVE "${ARCHIVE}"
     PATCHES
         msvc-convenience.diff
+        my-uwp-support.patch  #my-change: it MUST be applied before 'fix_clang-cl_build.patch'
         ${EXTRA_PATCHES}
 )
 
