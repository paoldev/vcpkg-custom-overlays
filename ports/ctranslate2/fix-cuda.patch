diff --git a/CMakeLists.txt b/CMakeLists.txt
index 83197bd..947e30c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 3.7)
+cmake_minimum_required(VERSION 3.27)
 
 # Set policy for setting the MSVC runtime library for static MSVC builds
 if(POLICY CMP0091)
@@ -491,7 +491,7 @@ if (WITH_CUDA)
   if(WITH_HIP)
     message(FATAL_ERROR "WITH_CUDA=ON incompatible with WITH_HIP=ON")
   endif()
-  find_package(CUDA 11.0 REQUIRED)
+  enable_language(CUDA)
   list(APPEND CMAKE_MODULE_PATH ${PROJECT_SOURCE_DIR}/cmake)
   if (WITH_TENSOR_PARALLEL)
     find_package(MPI REQUIRED)
@@ -524,7 +524,7 @@ if (WITH_CUDA)
   endif()
 
   if(NOT CUDA_ARCH_LIST)
-    set(CUDA_ARCH_LIST "Auto")
+    set(CUDA_ARCH_LIST ${CMAKE_CUDA_ARCHITECTURES})
   elseif(CUDA_ARCH_LIST STREQUAL "Common")
     set(CUDA_ARCH_LIST ${CUDA_COMMON_GPU_ARCHITECTURES})
     # Keep deprecated but not yet dropped Compute Capabilities.
@@ -534,8 +534,6 @@ if (WITH_CUDA)
     list(REMOVE_DUPLICATES CUDA_ARCH_LIST)
   endif()
 
-  cuda_select_nvcc_arch_flags(ARCH_FLAGS ${CUDA_ARCH_LIST})
-  list(APPEND CUDA_NVCC_FLAGS ${ARCH_FLAGS})
   set(CUDA_HOST_COMPILER ${CMAKE_CXX_COMPILER})
 
   # flags for flash attention
@@ -555,13 +553,13 @@ if (WITH_CUDA)
     ${CMAKE_CURRENT_SOURCE_DIR}/third_party/thrust/thrust
     ${CMAKE_CURRENT_SOURCE_DIR}/third_party/thrust/libcudacxx/include
     )
-  cuda_include_directories(${THRUST_INCLUDE_DIRS})
   list(APPEND PRIVATE_INCLUDE_DIRECTORIES ${THRUST_INCLUDE_DIRS})
 
+  find_package(NvidiaCutlass REQUIRED)
   set(CUTLASS_INCLUDE_DIRS
+    ${NvidiaCutlass_INCLUDE_DIRS}
     ${CMAKE_CURRENT_SOURCE_DIR}/third_party/cutlass/include
   )
-  cuda_include_directories(${CUTLASS_INCLUDE_DIRS})
   list(APPEND PRIVATE_INCLUDE_DIRECTORIES ${CUTLASS_INCLUDE_DIRS})
 
   if(WITH_CUDNN)
@@ -674,11 +672,35 @@ if (WITH_CUDA)
       PROPERTIES COMPILE_FLAGS "--use_fast_math")
   endif()
   set(CUDA_LINK_LIBRARIES_KEYWORD PRIVATE)
-  cuda_add_library(${PROJECT_NAME}
+
+  #Fix "Feature 'f16 arithemetic and compare instructions' requires .target sm_53 or higher" error for old gpus.
+  foreach(ARCH IN LISTS CUDA_ARCH_LIST)
+    if (${ARCH} LESS 53)
+      list(REMOVE_ITEM SOURCES
+        src/ops/awq/dequantize.cc
+        src/ops/awq/dequantize_cpu.cc
+        src/ops/awq/gemm.cc
+        src/ops/awq/gemm_cpu.cc
+        src/ops/awq/gemv.cc
+        src/ops/awq/gemv_cpu.cc
+      )
+      list(REMOVE_ITEM CUDA_SOURCES
+        src/ops/awq/gemm_gpu.cu
+        src/ops/awq/gemv_gpu.cu
+        src/ops/awq/dequantize_gpu.cu
+      )
+      add_definitions(-DCT2_IGNORE_FP16)
+      break()
+    endif()
+  endforeach()
+
+  add_library(${PROJECT_NAME}
     ${SOURCES}
     ${CUDA_SOURCES}
   )
-
+  set_target_properties(${PROJECT_NAME} PROPERTIES
+    CUDA_ARCHITECTURES ${CUDA_ARCH_LIST}
+  )
 
 elseif(WITH_HIP)
   if(WITH_TENSOR_PARALLEL)
