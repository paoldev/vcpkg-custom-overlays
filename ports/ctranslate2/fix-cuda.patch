diff --git a/src/cuda/cublas_stub.cc b/src/cuda/cublas_stub.cc
index a1d5bde..253192c 100644
--- a/src/cuda/cublas_stub.cc
+++ b/src/cuda/cublas_stub.cc
@@ -53,9 +53,31 @@ namespace ctranslate2 {
   static void* get_so_handle() {
     static auto so_handle = []() {
 #ifdef _WIN32
-      std::string cuda_path = read_string_from_env("CUDA_PATH");
+      std::string cuda_path;
+      // Set the same folder as cudart64_xx.dll, that should be already loaded.
+      std::string cudartModName = "cudart64_" + std::to_string(CUDART_VERSION / 1000);
+      HMODULE hModule = GetModuleHandleA(cudartModName.c_str());
+      if (hModule) {
+        char path[MAX_PATH] = {};
+        DWORD length = GetModuleFileNameA(hModule, path, MAX_PATH);
+        if (length > 0 && length < MAX_PATH) {
+          char* pLastSep = strrchr(path, '\\');
+          if (pLastSep == nullptr) {
+            pLastSep = strrchr(path, '/');
+          }
+          if (pLastSep != nullptr) {
+            *pLastSep = '\0';
+            cuda_path = path;
+          }
+        }
+      }
+      if (cuda_path.empty()) { // Fallback to default CUDA_PATH
+        cuda_path = read_string_from_env("CUDA_PATH");
+        if (!cuda_path.empty()) {
+          cuda_path += "\\bin";
+        }
+      }
       if (!cuda_path.empty()) {
-        cuda_path += "\\bin";
         SetDllDirectoryA(cuda_path.c_str());
       }
       void* handle = static_cast<void*>(LoadLibraryA(CUBLAS_LIBNAME));
